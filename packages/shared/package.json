{
  "name": "@deepseek-plugins/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared utilities: secure API Key storage via macOS Keychain",
  "type": "module",
  "main": "./dist/credentials.js",
  "types": "./dist/credentials.d.ts",
  "exports": {
    ".": {
      "types": "./dist/credentials.d.ts",
      "import": "./dist/credentials.js"
    }
  },
  "bin": {
    "deepseek-creds": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup src/cli.ts src/credentials.ts --format esm --dts --clean && chmod +x dist/cli.js",
    "dev": "tsup src/cli.ts src/credentials.ts --format esm --watch"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "commander": "^12.1.0",
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4"
  }
}
