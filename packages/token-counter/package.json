{
  "name": "@deepseek-plugins/token-counter",
  "version": "0.1.0",
  "private": true,
  "description": "Token usage counter via Claude Code statusline integration",
  "type": "module",
  "main": "./dist/counter.js",
  "types": "./dist/counter.d.ts",
  "exports": {
    ".": {
      "types": "./dist/counter.d.ts",
      "import": "./dist/counter.js"
    }
  },
  "scripts": {
    "build": "tsup src/counter.ts --format esm --dts --clean",
    "dev": "tsup src/counter.ts --format esm --watch",
    "test": "vitest run"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.5.0",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^2.1.0"
  }
}