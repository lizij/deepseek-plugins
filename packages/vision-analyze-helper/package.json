{
  "name": "@deepseek-plugins/vision-analyze-helper",
  "version": "0.1.0",
  "private": true,
  "description": "Image recognition helper CLI + cross-agent Skill for text-only models",
  "type": "module",
  "main": "./dist/config.js",
  "types": "./dist/config.d.ts",
  "exports": {
    ".": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./vision": {
      "types": "./dist/vision.d.ts",
      "import": "./dist/vision.js"
    }
  },
  "bin": {
    "vision-analyze-helper": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup src/cli.ts src/vision.ts src/image.ts src/config.ts --format esm --dts --clean && chmod +x dist/cli.js",
    "dev": "tsup src/cli.ts src/vision.ts --format esm --watch"
  },
  "dependencies": {
    "@deepseek-plugins/shared": "workspace:*",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4"
  }
}
