{
  "name": "@deepseek-plugins/menubar",
  "version": "0.1.0",
  "private": true,
  "description": "Native macOS menu bar app for DeepSeek plugins (balance, status, etc.)",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "main": "./dist/balance.js",
  "types": "./dist/balance.d.ts",
  "exports": {
    ".": {
      "types": "./dist/balance.d.ts",
      "import": "./dist/balance.js"
    }
  },
  "scripts": {
    "build": "tsup src/balance.ts --format esm --dts --clean",
    "dev": "tsup src/balance.ts --format esm --watch",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@deepseek-plugins/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^2.1.0"
  }
}