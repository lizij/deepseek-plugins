{
  "name": "deepseek-plugins",
  "version": "0.1.0",
  "private": true,
  "description": "Personal DeepSeek auxiliary plugins (vision helper + balance menubar)",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "clean": "pnpm -r exec rm -rf dist",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "dev": "pnpm -r --parallel dev"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^2.1.0"
  }
}
